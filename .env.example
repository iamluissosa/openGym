# openGym - Plantilla de Variables de Entorno
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=openGym
ADMIN_UIDS=
INVITE_ONLY=0

# Conexión a Base de Datos PostgreSQL (Supabase Pooler para Vercel / Serverless)
# En Supabase: Settings -> Database -> Connection string -> Transaction / Session Pooler (Puerto 6543 o 5432)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
